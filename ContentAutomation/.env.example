# Content Automation — Environment Configuration
# Copy this file to .env and fill in your values.
# Alternatively, set these as system environment variables.

# ─── VoiceStudio ──────────────────────────────────────────────────────────────
# The local VoiceStudio backend URL (default port 3900)
VOICESTUDIO_URL=http://localhost:3900

# Your cloned voice: set EITHER the ID or the name (name is easier to find)
# Run: python main.py list-voices
CLONED_VOICE_ID=
CLONED_VOICE_NAME=

# ─── LLM & AI Backends ────────────────────────────────────────────────────────
# OpenRouter (Global model gateway - recommended for high-accuracy technical scripts)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Omniroute proxy (running locally at port 20128 with 1.6 Billion tokens)
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_AUTH_TOKEN=omniroute
ANTHROPIC_MODEL=auto/best-free
IMAGE_GENERATION_URL=http://localhost:20128/v1/images/generations

# Backends: openrouter | omniroute (default) | ollama | openai | gemini
LLM_BACKEND=openrouter

# Voice Configuration: Default to KittenTTS for fast, effective explainer narration
DEFAULT_TTS_MODEL=kittentts
DEFAULT_TTS_VOICE=expr-voice-2-m

# Optional cloud APIs (automatically fails over to Omniroute if quota is reached)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# ─── Video Settings ───────────────────────────────────────────────────────────
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_BITRATE=5000k

# FFmpeg path (if not in PATH)
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
